export const SPLITS = {
  PEOPLE: 0.35,
  COMPANY: 0.30, 
  HUB: 0.10,
  WORLD: 0.25
}

export function calculateSplits(amount) {
  return {
    people: amount * SPLITS.PEOPLE,
    company: amount * SPLITS.COMPANY,
    hub: amount * SPLITS.HUB,
    world: amount * SPLITS.WORLD,
    total: amount,
    timestamp: new Date().toISOString()
  }
}
